# Copy to .env.local for `npm run dev`.
# Vercel: Project Settings → Environment Variables. Root Directory = web

# Supabase → Project Settings → API
# Project URL only (no /rest/v1). Example: https://abcd.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Auth → URL Configuration
# Site URL: https://YOUR_VERCEL_DOMAIN
# Redirect URLs: http://localhost:3000/auth/callback  and  https://YOUR_VERCEL_DOMAIN/auth/callback
# AES-256 key for encrypting stored Korea Investment app keys (server-only).
# Use a long random string. Never commit the real value.
KIS_CREDENTIALS_KEY=replace-with-a-long-random-secret
