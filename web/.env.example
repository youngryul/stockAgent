# Copy to .env.local for `npm run dev`.
# Vercel: Project Settings → Environment Variables. Root Directory = web

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Auth → URL Configuration
# Site URL: https://YOUR_VERCEL_DOMAIN
# Redirect URLs: http://localhost:3000/auth/callback  and  https://YOUR_VERCEL_DOMAIN/auth/callback
# For faster local signup, turn off "Confirm email" in Auth → Providers → Email.

# Docker agent must use the SAME Supabase Postgres (URI from Settings → Database).
# Example: postgresql+psycopg2://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Then: alembic upgrade head  (applies user_id columns + RLS)
