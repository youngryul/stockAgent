OPENAI_API_KEY=
DISCORD_WEBHOOK_URL=
# Same Supabase Postgres the website uses. Use Session pooler (IPv4), not Direct db.*.supabase.co.
# Dashboard: Settings → Database → Connection string → Session pooler (port 5432).
# Username is postgres.[PROJECT_REF], not postgres.
DATABASE_URL=postgresql+psycopg2://postgres.[PROJECT]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
LLM_MODEL=gpt-4.1-mini
SCHEDULE_INTERVAL_MINUTES=60
SCHEDULE_MODE=scan
DISCORD_MIN_CONFIDENCE=0.6
SCAN_SHORT_TOP_N=8
SCAN_LONG_TOP_N=8
SCAN_MIN_AVG_VOLUME=200000
SCAN_INCLUDE_WATCHLIST=true
